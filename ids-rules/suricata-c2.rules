# =====================================================================
# Suricata C2 & Threat Hunting Rules Set
# Author: Ajit Nayak (ajit028)
# Description: Equivalent Suricata rules optimized for fast multi-threaded inspection.
# =====================================================================

alert tcp any any -> any [80,443,8080,8443] (msg:"C2-TARGET Suricata - Cobalt Strike Default Stager URI Pattern"; flow:established,to_server; http.uri; content:"/s?="; depth:4; classtype:trojan-activity; sid:2000001; rev:1;)

alert tcp any any -> any [80,443,8080,8443] (msg:"C2-TARGET Suricata - Python Requests C2 User-Agent"; flow:established,to_server; http.header; content:"User-Agent: python-requests/"; classtype:trojan-activity; sid:2000002; rev:1;)

alert dns any any -> any 53 (msg:"C2-TARGET Suricata - DNS Tunneling Long Subdomain Label"; dns.query; pcre:"/^[a-zA-Z0-9\\-\\.]{50,}\\./"; classtype:trojan-activity; sid:2000003; rev:1;)

alert dns any any -> any 53 (msg:"C2-TARGET Suricata - DNS TXT Query Volume Spike"; dns.query; qtype:TXT; threshold:type threshold, track by_src, count 20, seconds 10; classtype:trojan-activity; sid:2000004; rev:1;)

alert tcp any any -> any [80,443,8080,8443] (msg:"C2-TARGET Suricata - Periodic HTTP Beaconing Pattern"; flow:established,to_server; http.uri; content:".php?id="; threshold:type both, track by_src, count 10, seconds 60; classtype:trojan-activity; sid:2000005; rev:1;)

alert tcp any any -> any [80,443,8080,8443] (msg:"C2-TARGET Suricata - PowerShell Empire Default Stager"; flow:established,to_server; http.uri; content:"/news.php"; classtype:trojan-activity; sid:2000006; rev:1;)

alert tls any any -> any any (msg:"C2-TARGET Suricata - Metasploit Self-Signed Cert Subject"; tls.cert_subject; content:"MetasploitRootCA"; classtype:trojan-activity; sid:2000007; rev:1;)

alert icmp any any -> any any (msg:"C2-TARGET Suricata - ICMP Payload Exfiltration Large Size"; icmp.type; content:"|08|"; dsize:>250; classtype:trojan-activity; sid:2000008; rev:1;)

alert tcp any any -> any [80,443,8080,8443] (msg:"C2-TARGET Suricata - Base64 Encoded URI Parameter Exfil"; flow:established,to_server; http.uri; pcre:"/\\?q=[A-Za-z0-9\\+\\/]{30,}={0,2}$/U"; classtype:trojan-activity; sid:2000009; rev:1;)

alert tcp any any -> any [80,443,8080,8443] (msg:"C2-TARGET Suricata - Empty HTTP User-Agent Header"; flow:established,to_server; http.header; pcre:"/^User-Agent\\x3a\\s*$/im"; classtype:trojan-activity; sid:2000010; rev:1;)
