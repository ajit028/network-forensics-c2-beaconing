# =====================================================================
# Snort C2 & Threat Hunting Rules Set
# Author: Ajit Nayak (ajit028)
# Description: Custom IDS rules for HTTP beaconing, DNS tunneling, and C2.
# =====================================================================

# 1. Detect Cobalt Strike Default Stager HTTP GET Request Pattern
alert tcp any any -> any $HTTP_PORTS (msg:"C2-TARGET Cobalt Strike Default Stager URI Pattern Detected"; flow:to_server,established; content:"/s?="; depth:4; http_uri; reference:mitre-attack,T1071.001; classtype:trojan-activity; sid:1000001; rev:1;)

# 2. Suspicious User-Agent Associated with Custom Python C2 Frameworks
alert tcp any any -> any $HTTP_PORTS (msg:"C2-TARGET Suspicious Python-Requests User-Agent in Traffic"; flow:to_server,established; content:"User-Agent|3a| python-requests/"; http_header; reference:mitre-attack,T1071.001; classtype:trojan-activity; sid:1000002; rev:1;)

# 3. DNS Tunneling - Extremely Long Subdomain Label
alert udp any any -> any 53 (msg:"C2-TARGET Potential DNS Tunneling - Long Subdomain Label"; content:"|01 00 00 01 00 00 00 00 00 00|"; depth:10; offset:2; byte_test:1,> ,45,20; reference:mitre-attack,T1071.004; classtype:trojan-activity; sid:1000003; rev:1;)

# 4. DNS High Volume TXT Record Queries (Data Exfiltration Indicator)
alert udp any any -> any 53 (msg:"C2-TARGET DNS TXT Query Volume Spike (Possible Exfiltration)"; content:"|00 10 00 01|"; distance:0; within:100; threshold:type threshold, track by_src, count 20, seconds 10; reference:mitre-attack,T1048; classtype:trojan-activity; sid:1000004; rev:1;)

# 5. HTTP Periodic Beaconing - Suspiciously Uniform URI Length & Headers
alert tcp any any -> any $HTTP_PORTS (msg:"C2-TARGET HTTP Beaconing - Uniform Request Pattern"; flow:to_server,established; content:"GET"; http_method; content:".php?id="; http_uri; threshold:type both, track by_src, count 10, seconds 60; reference:mitre-attack,T1071.001; classtype:trojan-activity; sid:1000005; rev:1;)

# 6. PowerShell Empire Default HTTP Beaconing URI (/download/ or /news.php)
alert tcp any any -> any $HTTP_PORTS (msg:"C2-TARGET PowerShell Empire Default Stager Profile"; flow:to_server,established; content:"/news.php"; http_uri; reference:mitre-attack,T1071.001; classtype:trojan-activity; sid:1000006; rev:1;)

# 7. Metasploit Meterpreter Reverse HTTPS Stager Certificate Anomaly / Common Subject
alert tls any any -> any any (msg:"C2-TARGET Metasploit Reverse HTTPS Self-Signed Cert Indicator"; flow:to_server,established; tls.cert; content:"MetasploitRootCA"; reference:mitre-attack,T1573.002; classtype:trojan-activity; sid:1000007; rev:1;)

# 8. ICMP Tunneling / Data Exfiltration via Large ICMP Payload
alert icmp any any -> any any (msg:"C2-TARGET ICMP Payload Exfiltration (Large Packet Size)"; icmp_type:8; dsize:>250; reference:mitre-attack,T1095; classtype:trojan-activity; sid:1000008; rev:1;)

# 9. Suspicious Base64 Encoded URI Parameters (Potential C2 Data Transmit)
alert tcp any any -> any $HTTP_PORTS (msg:"C2-TARGET Suspicious Base64 String in HTTP GET URI"; flow:to_server,established; content:"?q="; http_uri; pcre:"/\\?q=[A-Za-z0-9\\+\\/]{30,}={0,2}$/U"; reference:mitre-attack,T1071.001; classtype:trojan-activity; sid:1000009; rev:1;)

# 10. Blank or Minimal User-Agent in Outbound HTTP Traffic
alert tcp any any -> any $HTTP_PORTS (msg:"C2-TARGET Outbound HTTP Request with Empty or Missing User-Agent"; flow:to_server,established; http_header; pcre:"/^User-Agent\\x3a\\s*$/im"; reference:mitre-attack,T1071.001; classtype:trojan-activity; sid:1000010; rev:1;)
